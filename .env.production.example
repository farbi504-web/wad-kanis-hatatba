# ============================================
# Production Environment Variables
# واد كنيس حطاطبة - Production
# ============================================

# === Database ===
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require

# === Security (مهم جداً - غيّرها قبل النشر!) ===
AUTH_SECRET=GENERATE_WITH_openssl_rand_-base64_64
ENCRYPTION_KEY=GENERATE_RANDOM_64_CHARS
ENCRYPTION_SALT=your-unique-salt-here

# === Security Cookies ===
# في الإنتاج: 1
FORCE_SECURE_COOKIE=1

# === Seed Secret ===
SEED_SECRET=GENERATE_RANDOM_64_CHARS

# === Optional: Email (للإشعارات) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@wad-kanis.dz

# === Optional: SMS (للهاتف) ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === Optional: File Storage (للملفات الكبيرة) ===
# S3 / R2 / Supabase Storage
STORAGE_BUCKET=listing-images
STORAGE_REGION=auto

# === Logging ===
LOG_LEVEL=info
NODE_ENV=production
PORT=3000

# === Vercel Blob (تخزين الصور الدائم) ===
# مطلوب على Vercel لأن نظام ملفاته مؤقت والصور تُفقد بدونه.
# يُنشأ تلقائياً عند ربط Blob Store من لوحة Vercel > Storage.
# اتركه فارغاً محلياً أو على VPS ليُستخدم القرص المحلي (public/uploads).
BLOB_READ_WRITE_TOKEN=

# === حساب المدير (يُقرأ عند تشغيل /api/seed مرة واحدة) ===
# إلزامي: بدونه ترفض التهيئة إنشاء حساب المدير.
ADMIN_EMAIL=admin@wad-kanis.dz
ADMIN_PASSWORD=
ADMIN_PHONE=0555000000
