# systemd service for واد كنيس حطاطبة
# احفظه في /etc/systemd/system/wad-kanis.service

[Unit]
Description=واد كنيس حطاطبة - Next.js Application
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=wdk
Group=wdk
WorkingDirectory=/var/www/wad-kanis
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/var/www/wad-kanis/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wad-kanis

# Resource limits
LimitNOFILE=65536
MemoryMax=1G
CPUQuota=80%

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/wad-kanis /var/backups/wad-kanis /tmp

[Install]
WantedBy=multi-user.target
